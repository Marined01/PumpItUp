@model IEnumerable<PumpItUp.DAL.Models.Post>

@{
    ViewData["Title"] = "All Posts";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet"/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet"/>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f7fc;
        }

        .post-container {
            max-width: 800px;
            margin: 30px auto;
            padding: 20px;
            background-color: white;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        .post-title {
            font-size: 1.8rem;
            color: #333;
            font-weight: bold;
            margin-top: 10px;
        }

        .post-content {
            margin-top: 15px;
            font-size: 1rem;
            color: #555;
            height: 100px;
            overflow: hidden;
        }

        .post-meta {
            margin-top: 10px;
            color: #777;
            font-size: 0.9rem;
        }

        .post-meta p {
            margin: 5px 0;
        }

        .date {
            color: #007bff;
        }

        .btn-view {
            margin-top: 10px;
            background-color: #007bff;
            color: white;
            border: none;
            padding: 10px 20px;
            font-size: 1rem;
            cursor: pointer;
            border-radius: 5px;
        }

        .btn-view:hover {
            background-color: #0056b3;
        }

        .btn-delete {
            margin-top: 10px;
            background-color: #dc3545;
            color: white;
            border: none;
            padding: 10px 20px;
            font-size: 1rem;
            cursor: pointer;
            border-radius: 5px;
        }

        .btn-delete:hover {
            background-color: #c82333;
        }

        .btn-back {
            margin-top: 20px;
            background-color: #007bff;
            color: white;
            border: none;
            padding: 10px 20px;
            font-size: 1rem;
            cursor: pointer;
            border-radius: 5px;
        }

        .btn-back:hover {
            background-color: #0056b3;
        }

        .modal-content {
            padding: 20px;
            border-radius: 10px;
        }
    </style>
</head>
<body>

<div class="container">
    <div class="post-container">
        <h1 class="post-title">@ViewData["Title"]</h1>
        @foreach (var post in Model)
        {
            <div class="post-item">
                <h2 class="post-title">@post.Title</h2>
                <p class="post-content">@post.Content</p>

                <div class="post-meta">
                    <p><strong>Created at:</strong> <span
                            class="date">@post.CreatedAt.ToString("dd.MM.yyyy HH:mm:ss")</span></p>
                    <p><strong>Updated at:</strong> <span
                            class="date">@post.UpdatedAt?.ToString("dd.MM.yyyy HH:mm:ss") ?? "Not Updated Yet"</span>
                    </p>
                </div>

                <a href="@Url.Action("Details", "Post", new { id = post.Id })" class="btn btn-view">View Details</a>

                <form asp-action="DeletePost" method="post" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@post.Id"/>
                    <button type="submit" class="btn btn-delete">Delete</button>
                </form>
            </div>
            <hr/>
        }

        <a href="@Url.Action("Index", "Post")" class="btn btn-back">Back to Posts</a>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>