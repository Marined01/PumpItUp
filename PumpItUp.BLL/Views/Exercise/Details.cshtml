@model PumpItUp.BLL.Models.ViewModels.ExerciseSetViewModel

@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-4">
    <div class="d-flex flex-column align-items-center mb-4">
        <!-- Rounded Image -->
        <img src="@Model.ImageUrl" class="rounded-circle shadow mb-3" style="width: 220px; height: 220px; object-fit: cover; border: 6px solid #e6d6fa;" alt="@Model.Title">
        <!-- Info icons -->
        <div class="d-flex gap-4 mb-2 fs-5 fw-semibold text-purple">
            <span><i class="bi bi-fire me-1"></i>@Model.CaloriesBurned ккал</span>
            <span><i class="bi bi-clock me-1"></i>@Model.TrainingDurationMinutes хв</span>
            <span><i class="bi bi-list-ol me-1"></i>@Model.NumberOfExercises вправ</span>
        </div>
    </div>

    <!-- Опис -->
    <div class="mb-5">
        <h3 class="fw-bold text-purple mb-2" style="letter-spacing: 1px;">Опис</h3>
        <p class="lead" style="font-family: 'Segoe UI', 'Arial', sans-serif; color: #3d2a5a;">@Model.Description</p>
    </div>

    <!-- Вправи та Раунди -->
    <div class="d-flex flex-row gap-4 align-items-start">
        <!-- Вправи (2/3) -->
        <div class="flex-grow-1" style="flex-basis: 66%; min-width: 0;">
            <div class="p-4 bg-white rounded-4 shadow-sm mb-4" style="padding: 5px 10px;">
                <h4 class="fw-bold text-purple mb-4">Вправи</h4>
                <div class="d-flex flex-column gap-4">
                    @foreach (var exercise in Model.Exercises)
                    {
                        <div class="exercise-card p-3 rounded-4 border position-relative bg-light" style="padding: 10px;">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h5 class="fw-bold mb-0">@exercise.Name</h5>
                                <span class="badge bg-secondary">@exercise.Type</span>
                            </div>
                            <p class="mb-2 text-muted">@exercise.Description</p>
                            <div class="d-flex flex-wrap gap-3 small">
                                <span class="text-purple"><i class="bi bi-fire me-1"></i>@exercise.CaloriesBurnedPerMinute ккал/хв</span>
                                <span class="text-purple"><i class="bi bi-bar-chart me-1"></i>Складність: @exercise.DifficultyLevel</span>
                                <span class="text-purple"><i class="bi bi-person-arms-up me-1"></i>Частина тіла: @exercise.BodyPart</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
        <!-- Раунди (1/3) -->
        <div class="bg-white rounded-4 shadow-sm p-4" style="flex-basis: 33%; min-width: 260px;" style="padding: 10px;">
            <h4 class="fw-bold text-purple mb-4">Раунди</h4>
            <div class="d-flex flex-column gap-4">
                @for (int round = 1; round <= 3; round++)
                {
                    <div class="p-3 bg-light rounded-4 border">
                        <h6 class="fw-bold text-secondary mb-3">Раунд @round</h6>
                        <div class="d-flex flex-column gap-2">
                            @foreach (var exercise in Model.Exercises)
                            {
                                <div class="d-flex align-items-center rounded-pill px-3 py-2 bg-dark bg-opacity-75 text-white shadow-sm" style="cursor:pointer;">
                                    <button class="btn btn-light btn-sm rounded-circle me-2"><i class="bi bi-play-fill"></i></button>
                                    <div class="flex-grow-1">
                                        <span class="fw-semibold">@exercise.Name</span>
                                        <span class="ms-2 small text-secondary">@exercise.CaloriesBurnedPerMinute ккал</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .text-purple { color: #4b2676 !important; }
    .rounded-4 { border-radius: 1.5rem !important; }
    .exercise-card { border: 1.5px solid #e6d6fa; transition: box-shadow 0.2s; background: #f8f6fc !important; }
    .exercise-card:hover { box-shadow: 0 0 0 4px #e6d6fa; }
    .bg-light { background: #f8f6fc !important; }
    .shadow-sm { box-shadow: 0 2px 12px 0 rgba(76, 34, 112, 0.07) !important; }
</style>
