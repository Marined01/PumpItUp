@model System.Collections.Generic.List<PumpItUp.DAL.Models.User>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Details</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"/>
    <style>
        body {
            background-color: #f8f9fa;
            padding: 20px;
        }

        .table-container {
            max-width: 100%;
            overflow-x: auto;
        }

        .table th, .table td {
            text-align: center;
            vertical-align: middle;
        }
    </style>
</head>
<body>
<div class="container">
    <h2 class="text-center my-4">Students</h2>
    <div class="table-container">
        <table class="table table-striped table-bordered table-hover">
            <thead class="thead-dark">
            <tr>
                <th>Id</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Email</th>
                <th>Avatar</th>
                <th>Fitness Level</th>
                <th>Age</th>
                <th>Premium</th>
                <th>Created At</th>
                <th>Updated At</th>
                <th>Role ID</th>
                <th>Following ID</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Id</td>
                    <td>@user.FirstName</td>
                    <td>@user.LastName</td>
                    <td>@user.Email</td>
                    <td>
                        @if (!string.IsNullOrEmpty(user.AvatarUrl))
                        {
                            <img src="@user.AvatarUrl" alt="Avatar" class="img-fluid"
                                 style="width: 50px; height: 50px; border-radius: 50%;">
                        }
                    </td>
                    <td>@user.FitnessLevel</td>
                    <td>@user.Age</td>
                    <td>@(user.HasPremiumSubscription ? "Yes" : "No")</td>
                    <td>@user.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@user.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@user.RoleId</td>
                    <td>@user.FollowingId</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
</body>
</html>
