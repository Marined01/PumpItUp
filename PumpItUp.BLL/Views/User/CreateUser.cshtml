@model PumpItUp.DAL.DTOs.UserRequest

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add User</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500&display=swap" rel="stylesheet">

    <style>
        body {
            background-color: #eaeaea;
            font-family: 'Roboto', sans-serif;
            color: #333;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }

        .form-container {
            background-color: #fff;
            padding: 25px 45px 25px 25px;
            border-radius: 10px;
            box-shadow: 0 8px 15px rgba(0, 0, 0, 0.1);
            width: 100%;
            max-width: 380px;
            margin: 400px 15px 15px 15px;
        }

        h2 {
            color: #333;
            font-size: 24px;
            margin-bottom: 20px;
            font-weight: 500;
            text-align: center;
        }

        label {
            display: block;
            margin-bottom: 5px;
            font-size: 14px;
            color: #555;
        }

        input, select {
            width: 100%;
            padding: 10px;
            margin-bottom: 15px;
            border: 1px solid #ccc;
            border-radius: 8px;
            font-size: 16px;
            background-color: #f7f7f7;
            transition: border-color 0.3s;
        }

        input:focus, select:focus {
            border-color: #4a90e2;
            outline: none;
        }

        .password-container {
            position: relative;
        }

        .eye-icon {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            fill: #4a90e2;
        }

        button {
            background-color: #4a90e2;
            color: #fff;
            border: none;
            padding: 12px;
            border-radius: 8px;
            font-size: 18px;
            cursor: pointer;
            width: 100%;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            transition: background-color 0.3s;
        }

        button:hover {
            background-color: #357ab7;
        }

        .checkbox-container {
            display: flex;
            align-items: center;
            gap: 10px;
            justify-content: start;
            margin-bottom: 15px;
        }

        .checkbox-container input {
            width: auto;
        }

        .checkbox-container label {
            font-size: 14px;
            color: #555;
        }
    </style>
</head>
<body>

<div class="form-container">
    <h2>Add User</h2>
    <form asp-action="CreateUser" method="post">
        <label asp-for="FirstName">First Name:</label>
        <input asp-for="FirstName" required>

        <label asp-for="LastName">Last Name:</label>
        <input asp-for="LastName" required>

        <label asp-for="Email">Email:</label>
        <input asp-for="Email" type="email" required>

        <label asp-for="Password">Password:</label>
        <div class="password-container">
            <input asp-for="Password" type="password" required id="Password">
            <svg onclick="togglePassword()" class="eye-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                <path d="M12 6C7.03 6 3 9.33 3 12s4.03 6 9 6 9-3.33 9-6-4.03-6-9-6zm0 10c-2.4 0-4.4-1.53-5.26-3.66 1.43-.74 2.72-1.74 3.72-2.88 1.03 1.11 2.32 1.96 3.56 2.53C16.43 14.47 14.4 16 12 16zm0-4c-.69 0-1.35-.11-1.98-.31-1.55-.5-2.88-1.32-4.06-2.32-.74-.59-1.42-1.26-2.05-2.04C5.53 6.89 7.99 6 12 6c2.4 0 4.4 1.53 5.26 3.66-1.43.74-2.72 1.74-3.72 2.88-1.03-1.11-2.32-1.96-3.56-2.53C7.57 9.53 9.6 8 12 8c2.4 0 4.4 1.53 5.26 3.66-1.43-.74-2.72-1.74-3.72-2.88C16.43 14.47 14.4 16 12 16z"/>
            </svg>
        </div>

        <label asp-for="AvatarUrl">Avatar URL:</label>
        <input asp-for="AvatarUrl">

        <label asp-for="FitnessLevel">Fitness Level:</label>
        <select asp-for="FitnessLevel">
            <option value="Beginner">Beginner</option>
            <option value="Intermediate">Intermediate</option>
            <option value="Advanced">Advanced</option>
        </select>

        <label asp-for="Age">Age:</label>
        <input asp-for="Age" type="number" required>

        <label asp-for="Sex">Sex:</label>
        <select asp-for="Sex">
            <option value="Male">Male</option>
            <option value="Female">Female</option>
            <option value="Other">Other</option>
        </select>

        <label asp-for="BankData">Bank Data:</label>
        <input asp-for="BankData">

        <div class="checkbox-container">
            <input asp-for="HasPremiumSubscription" type="checkbox">
            <label asp-for="HasPremiumSubscription">Premium Subscription</label>
        </div>

        <label asp-for="RoleId">Role Id:</label>
        <input asp-for="RoleId" type="number">


        <label asp-for="FollowingId">Following ID:</label>
        <input asp-for="FollowingId" type="number">

        <button type="submit">Add User</button>
    </form>
</div>

<script>
    function togglePassword() {
        const passwordField = document.getElementById('Password');
        const type = passwordField.type === 'password' ? 'text' : 'password';
        passwordField.type = type;
    }
</script>

</body>
</html>
