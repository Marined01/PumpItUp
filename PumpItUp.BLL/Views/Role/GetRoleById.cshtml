@model PumpItUp.DAL.Models.Role

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Role Details</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
</head>
<body>
<div class="container mt-5">
    <h2 class="mb-4">Get Role Details</h2>

    <form id="roleForm" action="@Url.Action("GetRoleById", "Role")" method="get" class="mb-4">
        <div class="form-group">
            <label for="roleId">Enter Role ID:</label>
            <input type="number" name="roleId" id="roleId" class="form-control" required/>
        </div>
        <button type="submit" class="btn btn-primary">Get Role</button>
    </form>

    <div id="roleDetails" class="mt-4" style="display: none;">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title" id="roleName"></h5>
                <p class="card-text"><strong>Role Name:</strong> <span id="roleNameSpan"></span></p>
                <p class="card-text"><strong>User ID:</strong> <span id="roleUserId"></span></p>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        $('#roleForm').submit(function (event) {
            event.preventDefault();
            let roleId = $('#roleId').val();

            $.ajax({
                url: '@Url.Action("GetRoleById", "Role")',
                type: 'GET',
                data: {roleId: roleId},
                success: function (data) {
                    if (data) {
                        $('#roleDetails').show();
                        $('#roleName').text(data.name);
                        $('#roleNameSpan').text(data.name);
                        $('#roleUserId').text(data.userId || 'N/A');
                    } else {
                        alert(`Role with ID ${roleId} not found.`);
                        $('#roleDetails').hide();
                    }
                },
                error: function () {
                    alert('Error fetching role data.');
                    $('#roleDetails').hide();
                }
            });
        });
    });
</script>
</body>
</html>
