@model IEnumerable<PumpItUp.DAL.Models.Role>

@{
    ViewData["Title"] = "Delete Roles";
}

<h2>Delete Roles</h2>

<table class="table">
    <thead>
    <tr>
        <th>Role ID</th>
        <th>Name</th>
        <th>Action</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var role in Model)
    {
        <tr>
            <td>@role.Id</td>
            <td>@role.Name</td>
            <td>
                <form asp-action="DeleteRole" method="post">
                    <input type="hidden" name="roleId" value="@role.Id" />
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>

<a href="/Role/GetAllRoles" class="btn btn-secondary">Back to Roles</a>