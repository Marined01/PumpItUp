@model System.Collections.Generic.List<PumpItUp.DAL.Models.Attachment>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Details</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"/>
    <style>
        body {
            background-color: #f8f9fa;
            padding: 20px;
        }

        .table-container {
            max-width: 100%;
            overflow-x: auto;
        }

        .table th, .table td {
            text-align: center;
            vertical-align: middle;
        }
    </style>
</head>
<body>
<div class="container">
    <h2 class="text-center my-4">Attachments</h2>
    <div class="table-container">
        <table class="table table-striped table-bordered table-hover">
            <thead class="thead-dark">
            <tr>
                <th>Attachment ID</th>
                <th>File Url</th>
                <th>File Type</th>
                <th>Created At</th>
                <th>Updated At</th>
                <th>Post ID</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var attachment in Model)
            {
                <tr>
                    <td>@attachment.Id</td>
                    <td>
                        @if (!string.IsNullOrEmpty(attachment.FileUrl))
                        {
                            <img src="@attachment.FileUrl" alt="Avatar" class="img-fluid"
                                 style="width: 50px; height: 50px; border-radius: 50%;">
                        }
                    </td>
                    <td>@attachment.FileType</td>
                    <td>@attachment.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@attachment.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@attachment.PostId</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
</body>
</html>