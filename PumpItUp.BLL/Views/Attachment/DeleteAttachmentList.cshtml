@model IEnumerable<PumpItUp.DAL.Models.Attachment>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Delete Attachment</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500&display=swap" rel="stylesheet">
    <style>
        body {
            background-color: #eaeaea;
            font-family: 'Roboto', sans-serif;
            color: #333;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }

        .container {
            background-color: #fff;
            padding: 25px 45px;
            border-radius: 10px;
            box-shadow: 0 8px 15px rgba(0, 0, 0, 0.1);
            width: 100%;
            max-width: 600px;
            margin: 20px;
        }

        h2 {
            color: #333;
            font-size: 24px;
            margin-bottom: 20px;
            font-weight: 500;
            text-align: center;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }

        th, td {
            padding: 10px;
            border: 1px solid #ccc;
            text-align: left;
        }

        th {
            background-color: #f7f7f7;
        }

        button {
            background-color: #4a90e2;
            color: #fff;
            border: none;
            padding: 8px 12px;
            border-radius: 8px;
            font-size: 14px;
            cursor: pointer;
            transition: background-color 0.3s;
        }

        button:hover {
            background-color: #357ab7;
        }
    </style>
</head>
<body>

<div class="container">
    <h2>Delete Attachment</h2>
    <table>
        <thead>
        <tr>
            <th>File URL</th>
            <th>File Type</th>
            <th>Post ID</th>
            <th>Action</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var attachment in Model)
        {
            <tr>
                <td>@attachment.FileUrl</td>
                <td>@attachment.FileType</td>
                <td>@attachment.PostId</td>
                <td>
                    <form asp-action="DeleteAttachment" method="post">
                        <input type="hidden" name="attachmentId" value="@attachment.Id"/>
                        <button type="submit">Delete</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

</body>
</html>