@model PumpItUp.DAL.Models.Following

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Following Details</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
</head>
<body>
<div class="container mt-5">
    <h2 class="mb-4">Get Following Details</h2>

    <form id="followingForm" action="@Url.Action("GetFollowingById", "Following")" method="get" class="mb-4">
        <div class="form-group">
            <label for="followingId">Enter Following ID:</label>
            <input type="number" name="followingId" id="followingId" class="form-control" required />
        </div>
        <button type="submit" class="btn btn-primary">Get Following</button>
    </form>

    <div id="followingDetails" class="mt-4" style="display: none;">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title" id="followingName"></h5>
                <p class="card-text"><strong>Follower:</strong> <span id="followerIdSpan"></span></p>
                <p class="card-text"><strong>Following:</strong> <span id="followingIdSpan"></span></p>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        $('#followingForm').submit(function (event) {
            event.preventDefault();
            let followingId = $('#followingId').val();

            $.ajax({
                url: '@Url.Action("GetFollowingById", "Following")',
                type: 'GET',
                data: { followingId: followingId },
                success: function (data) {
                    if (data) {
                        $('#followingDetails').show();
                        $('#followingName').text(`Following ID: ${data.id}`);
                        $('#followerIdSpan').text(data.follower);
                        $('#followingIdSpan').text(data.following);
                    } else {
                        alert(`Following with ID ${followingId} not found.`);
                        $('#followingDetails').hide();
                    }
                },
                error: function () {
                    alert('Error fetching following data.');
                    $('#followingDetails').hide();
                }
            });
        });
    });
</script>
</body>
</html>