@model PumpItUp.DAL.Models.Following

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Following Details</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
</head>
<body>
<div class="container mt-5">
    <h2 class="mb-4">Following Details</h2>

    <form id="followingForm" action="@Url.Action("GetFollowingById", "Following")" method="get" class="mb-4">
        <div class="form-group">
            <label for="followingId">Enter Following ID:</label>
            <input type="number" name="followingId" id="followingId" class="form-control" required/>
        </div>
        <button type="submit" class="btn btn-primary">Get Following</button>
    </form>

    @if (Model != null)
    {
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Following ID: @Model.Id</h5>
                <p class="card-text"><strong>Follower:</strong> @Model.follower</p>
                <p class="card-text"><strong>Following:</strong> @Model.following</p>
            </div>
        </div>
    }
    else
    {
        <p class="text-danger">Following not found.</p>
    }
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</body>
</html>